    "import numpy as np\n",
    "\n",
    "def derivativeForPosition(x, vec, epsilon):\n",
    "    vecDerivative = np.zeros_like(vec)\n",
    "    for i in range(x.size):\n",
    "        vecDerivative[:, i] = derivative(vec[:, i], epsilon)\n",
    "    return vecDerivative"
   ]
